// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//// 👇 ENUMS GO HERE

enum ListingType {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  VILLA
  HOUSE
  STUDIO
  LAND
  OFFICE
  SHOP
}

enum ListingStatus {
  PENDING // Awaiting admin validation (Default)
  APPROVED // Moderation passed, eligible to be live
  REJECTED // Denied validation (never went live)
  SUSPENDED // Admin revoked approval after it was live (The "Undo" button)
  EXPIRED // The listing's paid or free time limit ran out
  ARCHIVED // Soft-deleted or successfully sold/rented
}

enum HealthPlaceSource {
  GOOGLE
  MADINATI
  IMPORT
}

enum HealthPlaceStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum SellerType {
  INDIVIDUAL
  SHOP
}

enum ShopStatus {
  DRAFT
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  CLOSED
}

enum ShopSubscriptionStatus {
  PENDING
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}
enum NewsSource {
  RSS
  ORIGINAL
}


enum EventMode {
  IN_PERSON
  ONLINE
  HYBRID
}

enum EventRecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  CANCELLED
  POSTPONED
  FINISHED
}

model User {
  id               String         @id @default(uuid())
  name             String
  email            String         @unique
  password         String?
  phone            String?
  avatar           String?
  city             String?
  roleId           String
  isActive         Boolean        @default(true)
  emailVerifiedAt  DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  profileCompleted Boolean        @default(false)
  // Journalistes uniquement : permet à l'admin de suspendre la publication
  // sans désactiver tout le compte (connexion/consultation restent possibles).
  canPublish       Boolean        @default(true)  // Company fields (business only)
  companyName      String?
  companyLogo      String?
  companyWebsite   String?
  boutiqueDescription String?
  boutiqueBanner      String?
  boutiquePhone       String?
  boutiqueEmail       String?
  boutiqueListingSort String? @default("newest")
  boutiqueFeaturedListingIds Json?
  notifications    Notification[]

  role              Role           @relation(fields: [roleId], references: [id])
  oauthProviders    OAuthProvider[]
  passwordReset     PasswordResetToken?
  subscriptions     Subscription[]
  favorites         Favorite[]
  jobListings       JobListing[]
  jobApplications   JobApplication[]
  jobAlerts         Alert[]        @relation("JobAlerts")
  realEstateListings RealEstateListing[]
  propertyInquiries PropertyInquiry[]
  reports           Report[]
  messages          BusinessMessage[]
  carListings    CarListing[]
  carInquiries   CarInquiry[]
  touristicListings  TouristicListing[]
  workerProfiles        WorkerProfile[]
  taskRequestsAsClient  TaskRequest[]   @relation("TaskRequestsAsClient")
  bookingsAsClient      Booking[]       @relation("BookingsAsClient")
  reviews               Review[]
  professionalSpaceListings ProfessionalSpaceListing[]
  healthPlaces         HealthPlace[]
  newsArticles         NewsArticle[]
  eventsCreated        Event[]        @relation("EventsCreatedBy")
  eventsOrganized      Event[]        @relation("EventsOrganizedBy")
  ownedShops           Shop[]         @relation("ShopOwner")
  shopMemberships      ShopMember[]

}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  users       User[]
}

model OAuthProvider {
  id         String   @id @default(uuid())
  userId     String
  provider   String
  providerId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  price         Decimal
  durationDays  Int
  maxListings   Int
  maxPhotos     Int
  canBoost      Boolean        @default(false)
  canSponsor    Boolean        @default(false)
  hasBadge      Boolean        @default(false)
  hasStatistics Boolean        @default(false)
  hasChat       Boolean        @default(false)
  subscriptions Subscription[]
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  planId    String
  status    String
  startedAt DateTime
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])
}

model Shop {
  id                 String     @id @default(uuid())
  ownerUserId        String
  name               String
  slug               String     @unique
  description        String?
  categoryId         String?
  logo               String?
  coverImage         String?
  city               String
  address            String?
  professionalPhone  String?
  professionalEmail  String?
  legalName          String?
  taxIdentifier      String?
  website            String?
  socialLinks        Json?
  openingHours       Json?
  status             ShopStatus @default(PENDING)
  isVerified         Boolean    @default(false)
  rejectionReason    String?
  adminNotes         String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  owner       User                   @relation("ShopOwner", fields: [ownerUserId], references: [id])
  category    Category?              @relation(fields: [categoryId], references: [id])
  members     ShopMember[]
  subscriptions ShopSubscription[]
  jobListings JobListing[]
  realEstateListings RealEstateListing[]
  carListings CarListing[]

  @@index([ownerUserId])
  @@index([categoryId])
  @@index([status])
  @@index([city])
  @@index([isVerified])
  @@index([createdAt])
}

model ShopMember {
  id        String   @id @default(uuid())
  shopId    String
  userId    String
  role      String   @default("OWNER")
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([shopId, userId])
  @@index([shopId])
  @@index([userId])
}

model ShopSubscriptionPlan {
  id             String             @id @default(uuid())
  name           String
  slug           String             @unique
  displayedPrice String
  billingPeriod  String             @default("monthly")
  listingLimit   Int
  features       Json
  active         Boolean            @default(true)
  displayOrder   Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  subscriptions ShopSubscription[]
}

model ShopSubscription {
  id        String                 @id @default(uuid())
  shopId    String
  planId    String
  status    ShopSubscriptionStatus @default(PENDING)
  startsAt  DateTime?
  expiresAt DateTime?
  cancelledAt DateTime?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan ShopSubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([shopId])
  @@index([planId])
  @@index([status])
  @@index([expiresAt])
}

model Favorite {
  id       String @id @default(uuid())
  userId   String
  itemId   String
  itemType String // "REAL_ESTATE" | "JOB" | etc.

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, itemId, itemType])
  @@index([userId])
}

//for tourisme listings
enum CategoryDisplayType {
  PLACE
  DOCUMENT
}

model Category {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  module             String // "emploi" | "immobilier" | "vehicule"
  displayType        CategoryDisplayType @default(PLACE) // ← new
  isActive           Boolean             @default(true)
  formTemplateId     String?
  jobListings        JobListing[]
  realEstateListings RealEstateListing[]
  carListings        CarListing[]
  touristicListings  TouristicListing[]
  news               NewsArticle[]
  healthPlaces       HealthPlace[]
  events             Event[]
  shops              Shop[]
  workerProfiles     WorkerProfile[]
  taskRequests       TaskRequest[]
  professionalSpaceListings ProfessionalSpaceListing[]
  formTemplate       FormTemplate?       @relation(fields: [formTemplateId], references: [id])

  @@index([formTemplateId])
}

model FormTemplate {
  id         String      @id @default(uuid())
  name       String      @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  categories Category[]
  fields     FormField[]
}

model FormField {
  id              String            @id @default(uuid())
  formTemplateId  String
  fieldName       String
  label           String
  fieldType       String
  required        Boolean           @default(false)
  options         Json?
  validationRules Json?
  displayOrder    Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  formTemplate FormTemplate      @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  values       EventFieldValue[]

  @@unique([formTemplateId, fieldName])
  @@index([formTemplateId, displayOrder])
}

enum EducationLevel {
  BEFORE_BAC
  BAC
  BAC_PLUS_1
  BAC_PLUS_2
  BAC_PLUS_3
  BAC_PLUS_4
  BAC_PLUS_5_PLUS
}

enum ExperienceLevel {
  STUDENT_FRESH_GRAD
  JUNIOR_LESS_2
  MID_2_TO_5
  SENIOR_5_TO_10
  EXPERT_PLUS_10
}

enum ContractType {
  CDI
  CDD
  INTERIM
  FREELANCE
  STAGE
  ANAPEC
  TEMPS_PARTIEL
  ALTERNANCE
  STATUTAIRE
}

enum RemoteType {
  ON_SITE // Présentiel
  REMOTE // Full remote
  HYBRID // Hybride / parfois
}

model JobListing {
  id                  String           @id @default(uuid())
  userId              String
  shopId              String?
  sellerType          SellerType       @default(INDIVIDUAL)
  categoryId          String
  title               String
  description         String
  companyName         String
  companyLogo         String?
  location            String
  city                String
  latitude            Decimal?
  longitude           Decimal?
  salaryMin           Decimal?
  salaryMax           Decimal?
  salaryPeriod        String?
  applicationDeadline DateTime?
  status              ListingStatus    @default(PENDING)
  isFeatured          Boolean          @default(false)
  isSponsored         Boolean          @default(false)
  boostExpiresAt      DateTime?
  viewsCount          Int              @default(0)
  skills              Json?
  adminNotes          String?
  reviewedAt          DateTime?
  reviewedBy          String?
  publishedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  contractType        ContractType
  educationLevel      EducationLevel[] @default([])
  experienceLevel     ExperienceLevel?
  region              String?
  remote              RemoteType       @default(ON_SITE)
  languages           Json?
  deletedByOwner      Boolean          @default(false)
  deletedAt           DateTime?

  user         User             @relation(fields: [userId], references: [id])
  shop         Shop?            @relation(fields: [shopId], references: [id])
  category     Category         @relation(fields: [categoryId], references: [id])
  applications JobApplication[]

  @@index([status])
  @@index([shopId])
  @@index([sellerType])
  @@index([categoryId])
  @@index([createdAt])
}

model JobApplication {
  id            String    @id @default(uuid())
  jobListingId  String
  userId        String
  coverLetter   String?
  cvPath        String?
  status        String    @default("pending")
  employerNotes String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  jobListing JobListing @relation(fields: [jobListingId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([userId, jobListingId])
}

model Alert {
  id        String   @id @default(uuid())
  userId    String
  module    String
  filters   Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation("JobAlerts", fields: [userId], references: [id])
}

model RealEstateListing {
  id             String            @id @default(uuid())
  userId         String
  shopId         String?
  sellerType     SellerType        @default(INDIVIDUAL)
  categoryId     String
  title          String
  slug           String?           @unique
  description    String
  listingType    ListingType
  propertyType   PropertyType
  price          Decimal
  priceNegotiable Boolean  @default(false)
  surface        Decimal?
  rooms          Int?
  bathrooms      Int?
  floor          Int?
  city           String // SIMPLE + SAFE (no City table yet)
  location       String
  latitude       Decimal?
  longitude      Decimal?
  contactPhone   String?
  images         Json? // [{ url, isCover }]
  features       Json? // flexible key/value
  status         ListingStatus     @default(PENDING)
  isActive       Boolean           @default(true)
  isFeatured     Boolean           @default(false)
  isSponsored    Boolean           @default(false)
  boostExpiresAt DateTime?
  viewsCount     Int               @default(0)
  adminNotes     String?
  reviewedAt     DateTime?
  reviewedBy     String?
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id])
  shop           Shop?             @relation(fields: [shopId], references: [id])
  category       Category          @relation(fields: [categoryId], references: [id])
  inquiries      PropertyInquiry[]
  region         String?
  deletedByOwner Boolean           @default(false)
  deletedAt      DateTime?

  @@index([categoryId])
  @@index([shopId])
  @@index([sellerType])
  @@index([status])
  @@index([price])
  @@index([city])
  @@index([createdAt])
}

model PropertyInquiry {
  id           String            @id @default(uuid())
  listingId    String
  userId       String
  message      String
  contactPhone String?
  contactEmail String?
  status       String            @default("pending")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  listing      RealEstateListing @relation(fields: [listingId], references: [id])
  user         User              @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([userId])
}

// ─── Signalement (Report) ────────────────────────────────────────────────────

enum ReportTarget {
  REAL_ESTATE
  JOB
  USER
  CAR
  TOURISM
  TASK_REQUEST
  REVIEW
  WORKER_PROFILE
  PROFESSIONAL_SPACE
  NEWS
}

enum ReportReason {
  FAKE
  FRAUD
  DUPLICATE
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  REJECTED
}

model Report {
  id            String       @id @default(uuid())
  targetType    ReportTarget
  targetId      String
  reason        ReportReason
  description   String?
  reporterEmail String? // Pour visiteurs anonymes
  userId        String? // Null si visiteur anonyme
  ipAddress     String?
  status        ReportStatus @default(PENDING)
  adminNotes    String?
  resolvedAt    DateTime?
  resolvedBy    String?
  createdAt     DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id])

  // Empêcher le double signalement (user + cible)
  @@unique([userId, targetId, targetType])
  @@index([targetId, targetType])
  @@index([status])
  @@index([ipAddress])
  @@index([createdAt])
}

enum MessageType {
  REJECTION
  REPORT_CONTACT
}

model BusinessMessage {
  id           String      @id @default(uuid())
  userId       String
  type         MessageType
  targetType   String
  targetId     String
  targetTitle  String
  adminMessage String
  isRead       Boolean     @default(false)
  createdAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model ListingView {
  id          String   @id @default(uuid())
  listingId   String
  listingType String // "JOB" | "REAL_ESTATE"
  userId      String? // null si visiteur anonyme/non connecté
  viewedAt    DateTime @default(now())

  @@index([listingId, listingType])
  @@index([listingType, viewedAt])
  @@index([viewedAt])
}

// ── Car Enums ─────────────────────────────────────────────────────────────────

enum CarListingType {
  SALE
  RENT
}

enum CarCondition {
  NEW
  USED
  DAMAGED
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  LPG
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
}

enum BodyType {
  SEDAN
  SUV
  HATCHBACK
  COUPE
  CONVERTIBLE
  WAGON
  VAN
  PICKUP
  MINIVAN
  OTHER
}

// ── Car Models ────────────────────────────────────────────────────────────────

model CarListing {
  id             String         @id @default(uuid())
  userId         String
  shopId         String?
  sellerType     SellerType     @default(INDIVIDUAL)
  categoryId     String
  title          String
  slug           String?        @unique
  description    String
  listingType    CarListingType
  condition      CarCondition
  make           String
  model          String
  year           Int
  mileage        Int?
  fuelType       FuelType
  transmission   Transmission
  bodyType       BodyType
  color          String?
  doors          Int?
  seats          Int?
  engineSize     Float?
  horsePower     Int?
  price          Decimal
  isNegotiable   Boolean        @default(false)
  city           String?
  region         String?
  location       String
  latitude       Decimal?
  longitude      Decimal?
  contactPhone   String?
  images         Json? // [{ url, isCover }]
  features       Json? // flexible key/value
  status         ListingStatus  @default(PENDING)
  isActive       Boolean        @default(true)
  isFeatured     Boolean        @default(false)
  isSponsored    Boolean        @default(false)
  boostExpiresAt DateTime?
  viewsCount     Int            @default(0)
  adminNotes     String?
  reviewedAt     DateTime?
  reviewedBy     String?
  publishedAt    DateTime?
  deletedByOwner Boolean        @default(false)
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user      User         @relation(fields: [userId], references: [id])
  shop      Shop?        @relation(fields: [shopId], references: [id])
  category  Category     @relation(fields: [categoryId], references: [id])
  inquiries CarInquiry[]

  @@index([userId])
  @@index([shopId])
  @@index([sellerType])
  @@index([categoryId])
  @@index([status])
  @@index([make])
  @@index([price])
  @@index([year])
  @@index([city])
  @@index([createdAt])
}

model CarInquiry {
  id           String   @id @default(uuid())
  listingId    String
  userId       String
  message      String
  contactPhone String?
  contactEmail String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listing CarListing @relation(fields: [listingId], references: [id])
  user    User       @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([userId])
}

//// ── tourisme Models ────────────────────────────────────────────────────────────────
model TouristicListing {
  id            String    @id @default(uuid())
  categoryId    String
  name          String
  slug          String?   @unique
  description   String?
  neighborhood  String?
  city          String?
  region        String?
  location      String?
  latitude      Decimal?
  longitude     Decimal?
  contactPhone  String?
  contactEmail  String?
  fileUrl       String?
  publishedAt   DateTime?
  downloadsCount Int      @default(0)
  images        Json?
  videoUrl      String?


  // Previously buried in `attributes` Json — now real, typed, filterable/sortable columns.
  rating        Decimal?  // 0.0 - 5.0
  prix          Int?      // DH, 0 = gratuit, null = not applicable for this category
  hours         String?   // "HH:MM - HH:MM" or "24h/24" or comma-separated ranges
  facebook      String?
  instagram     String?
  website       String?
  mapUrl        String?   // Google Maps share link the admin pasted, kept for reference/re-editing

  isActive      Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  viewsCount    Int       @default(0)
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category      Category  @relation(fields: [categoryId], references: [id])
  creator       User?     @relation(fields: [createdBy], references: [id])

  @@index([categoryId])
  @@index([city])
  @@index([isActive])
  @@index([createdAt])
  @@index([rating])
  @@index([prix])
}

//// ── Espaces Professionnels Models ────────────────────────────────────────
model ProfessionalSpaceListing {
  id            String    @id @default(uuid())
  categoryId    String
  name          String
  description   String?
  neighborhood  String?
  city          String?
  region        String?
  location      String?
  latitude      Decimal?
  longitude     Decimal?
  contactPhone  String?
  contactEmail  String?
  images        Json?     // [{ url, isCover }]
  attributes    Json?     // category-specific fields (surface, secteurs, services...)
  isActive      Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  viewsCount    Int       @default(0)
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category Category @relation(fields: [categoryId], references: [id])
  creator  User?    @relation(fields: [createdBy], references: [id])

  @@index([categoryId])
  @@index([city])
  @@index([isActive])
  @@index([createdAt])
}

model HealthPlace {
  id                  String            @id @default(uuid())
  googlePlaceId       String?           @unique
  source              HealthPlaceSource @default(MADINATI)
  name                String
  slug                String            @unique
  categoryId          String?
  subcategory         String
  googleTypes         String[]          @default([])
  description         String?
  address             String?
  neighborhood        String?
  city                String?
  region              String?
  postalCode          String?
  country             String            @default("MA")
  latitude            Decimal?
  longitude           Decimal?
  phones              Json?
  contactEmail        String?
  website             String?
  images              Json?
  googleMapsUri       String?
  businessStatus      String?
  rating              Decimal?
  userRatingCount     Int?
  regularHours        Json?
  currentHours        Json?
  openNow             Boolean?
  lastGoogleRefreshAt DateTime?
  status              HealthPlaceStatus @default(PENDING)
  isVerified          Boolean           @default(false)
  ownerId             String?
  reviewedAt          DateTime?
  reviewedBy          String?
  adminNotes          String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])
  owner    User?     @relation(fields: [ownerId], references: [id])

  @@index([googlePlaceId])
  @@index([subcategory])
  @@index([city])
  @@index([neighborhood])
  @@index([source])
  @@index([status])
  @@index([isVerified])
  @@index([latitude, longitude])
  @@index([createdAt])
}

model Event {
  id                         String              @id @default(uuid())
  title                      String
  titleAr                    String?
  slug                       String              @unique
  shortDescription           String?
  description                String
  categoryId                 String
  customSubsubcategory       String?
  organizerName              String
  organizerId                String?
  organizerPhone             String?
  organizerEmail             String?
  websiteUrl                 String?
  eventMode                  EventMode           @default(IN_PERSON)
  venueName                  String?
  address                    String?
  city                       String
  province                   String?
  region                     String?
  latitude                   Decimal?
  longitude                  Decimal?
  onlineUrl                  String?
  timezone                   String              @default("Africa/Casablanca")
  startsAt                   DateTime
  endsAt                     DateTime
  doorsOpenAt                DateTime?
  recurrenceType             EventRecurrenceType @default(NONE)
  recurrenceRule             String?
  recurrenceEndsAt           DateTime?
  isFree                     Boolean             @default(true)
  priceMin                   Decimal?
  priceMax                   Decimal?
  currency                   String              @default("MAD")
  ticketUrl                  String?
  reservationRequired        Boolean             @default(false)
  capacity                   Int?
  ageRestriction             String?
  accessibilityInformation   String?
  mainImage                  String?
  gallery                    Json?
  status                     EventStatus         @default(PENDING_REVIEW)
  featured                   Boolean             @default(false)
  verified                   Boolean             @default(false)
  publishedAt                DateTime?
  source                     String?
  sourceUrl                  String?
  sourceVerifiedAt           DateTime?
  createdById                String
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  category  Category @relation(fields: [categoryId], references: [id])
  organizer User?    @relation("EventsOrganizedBy", fields: [organizerId], references: [id])
  createdBy User     @relation("EventsCreatedBy", fields: [createdById], references: [id])
  fieldValues EventFieldValue[]

  @@index([categoryId])
  @@index([customSubsubcategory])
  @@index([status])
  @@index([city])
  @@index([province])
  @@index([region])
  @@index([startsAt])
  @@index([endsAt])
  @@index([featured])
  @@index([verified])
  @@index([latitude, longitude])
  @@index([createdAt])
}

model EventFieldValue {
  id          String   @id @default(uuid())
  eventId     String
  formFieldId String
  value       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  formField FormField @relation(fields: [formFieldId], references: [id], onDelete: Cascade)

  @@unique([eventId, formFieldId])
  @@index([eventId])
  @@index([formFieldId])
}

// ============================================================
// MINI-JOBS MODULE
// ENUMS

enum WorkerProfileStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum PricingUnit {
  HOUR
  DAY
  TASK
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

// No PENDING here on purpose — TaskRequest publishes immediately
// (reactive moderation via Report, not pre-approval)
enum TaskRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum TaskApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ReviewTargetType {
  WORKER_PROFILE
  // future: HOTEL, PHARMACY, SANTE, ...
}

model WorkerProfile {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  headline      String
  description   String
  city          String
  region        String?
  latitude      Decimal?
  longitude     Decimal?
  serviceRadius Int? // km

  pricingUnit  PricingUnit
  rate         Decimal
  isNegotiable Boolean     @default(false)

  photo           String? // Cloudinary URL
  portfolioImages Json? // [{url}]
  yearsExperience Int?
  availability    Json? // {mon:[9,18], tue:[...], ...}

  status      WorkerProfileStatus @default(PENDING)
  isActive    Boolean             @default(true)
  isFeatured  Boolean             @default(false)
  viewsCount  Int                 @default(0)
  ratingAvg   Decimal?            @default(0)
  ratingCount Int                 @default(0)

  adminNotes     String?
  reviewedAt     DateTime?
  reviewedBy     String?
  publishedAt    DateTime?
  deletedByOwner Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  bookings     Booking[]
  applications TaskApplication[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([city])
  @@index([rate])
  @@index([createdAt])
}

// MODEL: TaskRequest  (Model B — client posts a task)

model TaskRequest {
  id         String   @id @default(uuid())
  userId     String // the client posting the task
  user       User     @relation("TaskRequestsAsClient", fields: [userId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  title       String
  description String
  city        String
  region      String?
  latitude    Decimal?
  longitude   Decimal?
  location    String?
  budget      Decimal? // estimated/proposed rate, optional
  neededDate  DateTime

  status     TaskRequestStatus @default(OPEN)
  viewsCount Int               @default(0)

  // reactive moderation only (no PENDING gate) — admin can still act after the fact
  adminNotes String?
  reviewedAt DateTime?
  reviewedBy String?

  deletedByOwner Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  applications TaskApplication[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([city])
  @@index([createdAt])
  @@index([neededDate])
}

// MODEL: TaskApplication  (worker applies to a TaskRequest)

model TaskApplication {
  id              String        @id @default(uuid())
  taskRequestId   String
  taskRequest     TaskRequest   @relation(fields: [taskRequestId], references: [id])
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id])

  message      String?
  status       TaskApplicationStatus @default(PENDING)
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review?

  @@unique([taskRequestId, workerProfileId])
  @@index([taskRequestId])
  @@index([workerProfileId])
  @@index([status])
}

// MODEL: Booking  (Model A — direct booking request)

model Booking {
  id              String        @id @default(uuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id])
  clientId        String
  client          User          @relation("BookingsAsClient", fields: [clientId], references: [id])

  taskDescription String
  requestedDate   DateTime
  estimatedHours  Int?
  status          BookingStatus @default(PENDING)
  workerNote      String?
  clientPhone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review?

  @@index([workerProfileId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

// MODEL: Review  (universal — reused across future verticals too)

model Review {
  id                String           @id @default(uuid())
  targetType        ReviewTargetType
  targetId          String
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  bookingId         String?          @unique
  booking           Booking?         @relation(fields: [bookingId], references: [id])
  taskApplicationId String?          @unique
  taskApplication   TaskApplication? @relation(fields: [taskApplicationId], references: [id])

  rating     Int // 1-5
  comment    String?
  isVerified Boolean @default(false) // true when bookingId or taskApplicationId is set

  createdAt DateTime @default(now())

  @@unique([userId, targetId, targetType])
  @@index([targetType, targetId])
  @@index([userId])
}

enum NewsLanguage {
  AR
  FR
}

enum FetchStatus {
  SUCCESS
  FAILED
}
enum NewsContentType {
  ARTICLE
  VIDEO
}
model NewsArticle {
  id          String       @id @default(cuid())
  title       String
  description String       @db.Text
  imageUrl    String?
  videoUrl    String?
  contentType NewsContentType @default(ARTICLE)
  sourceUrl   String?      @unique
  language    NewsLanguage
  city        String?
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id])
  publishedAt DateTime

  source      NewsSource    @default(RSS)
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  status      ListingStatus @default(APPROVED)
  adminNotes  String?
  reviewedAt  DateTime?
  reviewedBy  String?

  // Compteur d'éditions, simple trace d'audit visible admin + journaliste
  // (pas de snapshot de version, pas de diff — juste un nombre incrémenté).
  editCount   Int          @default(0)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([language, publishedAt])
  @@index([status])
  @@index([source])
  @@index([userId])
  @@index([city])
  @@index([contentType])
  @@map("news_articles")
}

model FetchLog {
  id            String      @id @default(cuid())
  source        String      // ex: "hespress_ar" / "hespress_fr"
  status        FetchStatus
  itemsFetched  Int         @default(0)
  errorMessage  String?     @db.Text
  runAt         DateTime    @default(now())

  @@map("fetch_logs")
}
