// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//// 👇 ENUMS GO HERE

enum ListingType {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  VILLA
  HOUSE
  STUDIO
  LAND
  OFFICE
  SHOP
}

enum ListingStatus {
  PENDING      // Awaiting admin validation (Default)
  APPROVED     // Moderation passed, eligible to be live
  REJECTED     // Denied validation (never went live)
  SUSPENDED    // Admin revoked approval after it was live (The "Undo" button)
  EXPIRED      // The listing's paid or free time limit ran out
  ARCHIVED     // Soft-deleted or successfully sold/rented
}

model User {
  id                String         @id @default(uuid())
  name              String
  email             String         @unique
  password          String?
  phone             String?
  avatar            String?
  city              String?
  roleId            String
  isActive          Boolean        @default(true)
  emailVerifiedAt   DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  profileCompleted  Boolean        @default(false)
    // Company fields (business only)
  companyName       String?
  companyLogo       String?
  companyWebsite    String?
  notifications     Notification[]

  role              Role           @relation(fields: [roleId], references: [id])
  oauthProviders    OAuthProvider[]
  passwordReset     PasswordResetToken?
  subscriptions     Subscription[]
  favorites         Favorite[]
  jobListings       JobListing[]
  jobApplications   JobApplication[]
  jobAlerts         Alert[]        @relation("JobAlerts")
  realEstateListings RealEstateListing[]
  propertyInquiries PropertyInquiry[]
  reports           Report[]
  messages          BusinessMessage[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  users       User[]
}

model OAuthProvider {
  id         String   @id @default(uuid())
  userId     String
  provider   String
  providerId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  price         Decimal
  durationDays  Int
  maxListings   Int
  maxPhotos     Int
  canBoost      Boolean        @default(false)
  canSponsor    Boolean        @default(false)
  hasBadge      Boolean        @default(false)
  hasStatistics Boolean        @default(false)
  hasChat       Boolean        @default(false)
  subscriptions Subscription[]
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  planId    String
  status    String
  startedAt DateTime
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id])
  plan      Plan     @relation(fields: [planId], references: [id])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  itemId    String
  itemType  String   // "REAL_ESTATE" | "JOB" | etc.

  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, itemId, itemType])
  @@index([userId])
}

model Category {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  module             String              // "emploi" | "immobilier" | "vehicule"
  isActive           Boolean             @default(true)
  jobListings        JobListing[]
  realEstateListings RealEstateListing[]
}

enum EducationLevel {
  BEFORE_BAC
  BAC
  BAC_PLUS_1
  BAC_PLUS_2
  BAC_PLUS_3
  BAC_PLUS_4
  BAC_PLUS_5_PLUS
}

enum ExperienceLevel {
  STUDENT_FRESH_GRAD
  JUNIOR_LESS_2
  MID_2_TO_5
  SENIOR_5_TO_10
  EXPERT_PLUS_10
}

enum ContractType {
  CDI
  CDD
  INTERIM
  FREELANCE
  STAGE
  ANAPEC
  TEMPS_PARTIEL
  ALTERNANCE
  STATUTAIRE
}
enum RemoteType {
  ON_SITE      // Présentiel
  REMOTE       // Full remote
  HYBRID       // Hybride / parfois
}

model JobListing {
  id                  String        @id @default(uuid())
  userId              String
  categoryId          String
  title               String
  description         String
  companyName         String
  companyLogo         String?
  location            String
  latitude            Decimal?
  longitude           Decimal?
  salaryMin           Decimal?
  salaryMax           Decimal?
  salaryPeriod        String?
  applicationDeadline DateTime?
  status              ListingStatus     @default(PENDING)
  isFeatured          Boolean       @default(false)
  isSponsored         Boolean       @default(false)
  boostExpiresAt      DateTime?
  viewsCount          Int           @default(0)
  skills              Json?
  adminNotes          String?
  reviewedAt          DateTime?
  reviewedBy          String?
  publishedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  contractType        ContractType
  educationLevel      EducationLevel[]  @default([])
  experienceLevel     ExperienceLevel?
  region              String?
  remote              RemoteType    @default(ON_SITE)
  languages           Json?
  deletedByOwner  Boolean  @default(false)
  deletedAt       DateTime?

  user                User          @relation(fields: [userId], references: [id])
  category            Category      @relation(fields: [categoryId], references: [id])
  applications        JobApplication[]

  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
}

model JobApplication {
  id            String    @id @default(uuid())
  jobListingId  String
  userId        String
  coverLetter   String?
  cvPath        String?
  status        String    @default("pending")
  employerNotes String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  jobListing    JobListing @relation(fields: [jobListingId], references: [id])
  user          User       @relation(fields: [userId], references: [id])
  @@unique([userId, jobListingId])
  
}

model Alert {
  id        String   @id @default(uuid())
  userId    String
  module    String
  filters   Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation("JobAlerts", fields: [userId], references: [id])
}

model RealEstateListing {
  id            String         @id @default(uuid())
  userId        String
  categoryId    String
  title         String
  slug          String?        @unique
  description   String
  listingType   ListingType
  propertyType  PropertyType
  price         Decimal
  surface       Decimal?
  rooms         Int?
  bathrooms     Int?
  floor         Int?
  city          String     // SIMPLE + SAFE (no City table yet)
  location      String
  latitude      Decimal?
  longitude     Decimal?
  contactPhone  String?
  images        Json?          // [{ url, isCover }]
  features      Json?          // flexible key/value
  status        ListingStatus  @default(PENDING)
  isActive      Boolean        @default(true)
  isFeatured    Boolean        @default(false)
  isSponsored   Boolean        @default(false)
  boostExpiresAt DateTime?
  viewsCount    Int            @default(0)
  adminNotes    String?
  reviewedAt    DateTime?
  reviewedBy    String?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User           @relation(fields: [userId], references: [id])
  category      Category       @relation(fields: [categoryId], references: [id])
  inquiries     PropertyInquiry[]
  region        String?
  deletedByOwner  Boolean  @default(false)
  deletedAt       DateTime?

  @@index([categoryId])
  @@index([status])
  @@index([price])
  @@index([city])
  @@index([createdAt])
} 

model PropertyInquiry {
  id           String            @id @default(uuid())
  listingId    String
  userId       String
  message      String
  contactPhone  String?
  contactEmail  String?
  status       String           @default("pending")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  listing      RealEstateListing @relation(fields: [listingId], references: [id])
  user         User              @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([userId])
}

// ─── Signalement (Report) ────────────────────────────────────────────────────

enum ReportTarget {
  REAL_ESTATE
  JOB
  USER
}

enum ReportReason {
  FAKE
  FRAUD
  DUPLICATE
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  REJECTED
}

model Report {
  id            String       @id @default(uuid())
  targetType    ReportTarget
  targetId      String
  reason        ReportReason
  description   String?
  reporterEmail String?      // Pour visiteurs anonymes
  userId        String?      // Null si visiteur anonyme
  ipAddress     String?
  status        ReportStatus @default(PENDING)
  adminNotes    String?
  resolvedAt    DateTime?
  resolvedBy    String?
  createdAt     DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id])

  // Empêcher le double signalement (user + cible)
  @@unique([userId, targetId, targetType])
  @@index([targetId, targetType])
  @@index([status])
  @@index([ipAddress])
  @@index([createdAt])
}

enum MessageType {
  REJECTION
  REPORT_CONTACT
}

model BusinessMessage {
  id           String      @id @default(uuid())
  userId       String
  type         MessageType
  targetType   String
  targetId     String
  targetTitle  String
  adminMessage String
  isRead       Boolean     @default(false)
  createdAt    DateTime    @default(now())

  user         User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}